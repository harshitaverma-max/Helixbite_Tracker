# Copy to .env and fill in as each integration goes live.
# Any variable left unset falls back to demo/mock data for that source.

PORT=4000

# Instagram Graph API (Business/Creator account required)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Amazon Selling Partner API
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_MARKETPLACE_ID=
AMAZON_SP_API_REGION=na

# Website order webhook (Shopify "X-Shopify-Hmac-Sha256" or WooCommerce
# "X-WC-Webhook-Signature" secret)
WEBSITE_WEBHOOK_SECRET=

# WhatsApp Cloud API webhook verification (Meta app -> WhatsApp -> Configuration)
WHATSAPP_VERIFY_TOKEN=
